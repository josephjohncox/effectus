# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
out/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Binary output directory
bin/

#VSCode
.vscode/
.direnv/


# Build and output artifacts
*.log
**/dist/
**/build/
site/
**/.DS_Store

# Generated assets
# Commit reproducible Go protobuf bindings. Ignore other generated clients.
gen/*
!gen/effectus/
gen/effectus/*
!gen/effectus/v1/
gen/effectus/v1/*
!gen/effectus/v1/*.pb.go
node_modules/
*.vsix
coverage.html

# Python gRPC example tools and generated bindings (beside their proto package).
.tools/grpc-example-venv/
effectus/v1/*_pb2.py
effectus/v1/*_pb2_grpc.py
effectus/v1/*_pb2.pyi
effectus/v1/__pycache__/
examples/grpc_execution/__pycache__/

# Buf Generated
**/clients/
.gocache/
